rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================================
    // Helper Functions for Data Validation & Security
    // ==========================================================
    function isSignedIn() {
      return request.auth != null;
    }

    // Identifies the trusted server-side accounting engine worker
    function isAccountingBackend() {
      return request.auth != null && request.auth.token.email == 'accounting-engine@drfix.repair';
    }

    // Identifies authenticated staff portal users or backend workers
    function isStaffOrBackend() {
      return request.auth != null && (
        request.auth.token.email == 'accounting-engine@drfix.repair'
        || request.auth.token.email == 'staff-portal@drfix.repair'
      );
    }

    function isValidPhone(phone) {
      return phone is string && phone.size() >= 9 && phone.size() <= 30;
    }

    function isValidBooking(data) {
      return (data.customerPhone is string && isValidPhone(data.customerPhone))
        || (data.phone is string && isValidPhone(data.phone))
        || (data.plateNumber is string);
    }

    function isValidCustomer(data) {
      return (data.phone is string && isValidPhone(data.phone))
        || (data.customerPhone is string && isValidPhone(data.customerPhone))
        || (data.email is string && data.email.size() >= 3)
        || (data.googleUid is string && data.googleUid.size() > 0)
        || (data.name is string && data.name.size() > 0);
    }

    function isValidReview(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2500
        && data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    function isCustomerSecurityProtected() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['googleUid', 'linkVerificationStatus', 'approvedBy', 'approvedAt', 'linkVerificationCodeHash', 'blockedUntil']);
    }

    // ==========================================================
    // Public Services, Offers, Gallery & Partners
    // ==========================================================
    match /services/{serviceId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isStaffOrBackend();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isStaffOrBackend();
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isStaffOrBackend();
    }

    match /partners/{partnerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isStaffOrBackend();
    }

    match /contracts/{contractId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isStaffOrBackend();
    }

    // ==========================================================
    // Official Corporate Documents & Letterhead (Independent Protected Collection)
    // ==========================================================
    match /official_documents/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isStaffOrBackend();
    }

    // ==========================================================
    // Testimonials / Reviews
    // ==========================================================
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isValidReview(request.resource.data);
      allow update, delete: if true;
    }

    // ==========================================================
    // Maintenance & Bookings
    // Protected against arbitrary deletion and invalid payloads
    // Public reads removed: accessible via /api/booking/track, staff API, or verified owner
    // ==========================================================
    match /maintenance/{recordId} {
      allow read: if isStaffOrBackend()
        || (isSignedIn() && (
          (resource.data.googleUid is string && resource.data.googleUid == request.auth.uid)
          || (resource.data.customerGoogleUid is string && resource.data.customerGoogleUid == request.auth.uid)
          || (resource.data.customerId is string && resource.data.customerId == request.auth.uid)
          || (resource.data.assignedStaffId is string && resource.data.assignedStaffId == request.auth.uid)
        ));
      allow create: if isValidBooking(request.resource.data);
      allow update: if isStaffOrBackend();
      allow delete: if isStaffOrBackend();
    }

    // ==========================================================
    // Customers Collection (Secured against unauthorized linking & tampering)
    // No blanket staff-portal access; strictly authenticated owner or backend API
    // ==========================================================
    match /customers/{customerId} {
      allow read: if isAccountingBackend()
        || (isSignedIn() && resource.data.googleUid is string && resource.data.googleUid == request.auth.uid);

      allow create: if isAccountingBackend()
        || (isSignedIn() && isValidCustomer(request.resource.data) && request.resource.data.googleUid == request.auth.uid
            && !('linkVerificationCodeHash' in request.resource.data)
            && (!('linkVerificationStatus' in request.resource.data) || request.resource.data.linkVerificationStatus != 'verified'));

      allow update: if isAccountingBackend()
        || (isSignedIn() && resource.data.googleUid == request.auth.uid && isCustomerSecurityProtected());

      allow delete: if false;
    }

    // ==========================================================
    // Settings & Configuration
    // ==========================================================
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ==========================================================
    // Site Statistics & Analytics
    // ==========================================================
    match /stats/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /analytics/{dateId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ==========================================================
    // Staff & Employees Accounts
    // Direct browser read completely blocked; served via /api/staff/list
    // ==========================================================
    match /staff/{staffId} {
      allow read, write: if isAccountingBackend();
    }

    // ==========================================================
    // Inventory Management
    // ==========================================================
    match /inventory/{itemId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ==========================================================
    // Notifications
    // ==========================================================
    match /notifications/{notifId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ==========================================================
    // Inspection Videos
    // ==========================================================
    match /inspection_videos/{chunkId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ==========================================================
    // FCM Device Tokens
    // ==========================================================
    match /fcm_tokens/{tokenId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ==========================================================
    // Vehicle Handover & Repair Tracking System
    // ==========================================================
    match /vehicle_handovers/{handoverId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /handover_audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // ==========================================================
    // Accounting & Financial Management (STRICT ZERO-TRUST ISOLATION)
    // Direct client/browser reads & writes are 100% BLOCKED.
    // Customers, technicians, and visitors receive PERMISSION_DENIED.
    // Access is granted SOLELY to the authenticated backend engine worker.
    // ==========================================================
    match /customer_financial_accounts/{docId} {
      allow read, write: if isAccountingBackend();
    }
    match /accounting_services/{docId} {
      allow read, write: if isAccountingBackend();
    }
    match /accounting_vouchers/{docId} {
      allow read, write: if isAccountingBackend();
    }
    match /accounting_purchases/{docId} {
      allow read, write: if isAccountingBackend();
    }
    match /accounting_expenses/{docId} {
      allow read, write: if isAccountingBackend();
    }
    match /accounting_audit_logs/{docId} {
      allow read, write: if isAccountingBackend();
    }
    match /manual_payments/{paymentId} {
      allow read, write: if isAccountingBackend();
    }
    match /payment_roles/{roleId} {
      allow read, write: if isAccountingBackend();
    }
    match /payment_users/{userId} {
      allow read, write: if isAccountingBackend();
    }
    match /payment_audit_logs/{logId} {
      allow read, write: if isAccountingBackend();
    }

    // ==========================================================
    // Global Default Fallback (Default-Deny)
    // ==========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
