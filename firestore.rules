rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================================
    // Helper Functions for Data Validation & Security
    // ==========================================================
    function isValidPhone(phone) {
      return phone is string && phone.size() >= 9 && phone.size() <= 30;
    }

    function isValidBooking(data) {
      return (data.customerPhone is string && isValidPhone(data.customerPhone))
        || (data.phone is string && isValidPhone(data.phone))
        || (data.plateNumber is string);
    }

    function isValidCustomer(data) {
      return (data.phone is string && isValidPhone(data.phone))
        || (data.customerPhone is string && isValidPhone(data.customerPhone))
        || (data.email is string && data.email.size() >= 3)
        || (data.googleUid is string && data.googleUid.size() > 0)
        || (data.name is string && data.name.size() > 0);
    }

    function isValidReview(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2500
        && data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    // ==========================================================
    // Public Services, Offers, Gallery & Partners
    // ==========================================================
    match /services/{serviceId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /offers/{offerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /partners/{partnerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /contracts/{contractId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // ==========================================================
    // Testimonials / Reviews
    // ==========================================================
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isValidReview(request.resource.data) || true;
      allow update, delete: if true;
    }

    // ==========================================================
    // Maintenance & Bookings
    // ==========================================================
    match /maintenance/{recordId} {
      allow read: if true;
      allow create: if isValidBooking(request.resource.data) || true;
      allow update: if true;
      allow delete: if true;
    }

    // ==========================================================
    // Customers Collection
    // ==========================================================
    match /customers/{customerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // ==========================================================
    // Settings & Configuration
    // ==========================================================
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // ==========================================================
    // Site Statistics & Analytics
    // ==========================================================
    match /stats/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /analytics/{dateId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // ==========================================================
    // Staff & Employees Accounts
    // ==========================================================
    match /staff/{staffId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // ==========================================================
    // Inventory Management
    // ==========================================================
    match /inventory/{itemId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // ==========================================================
    // Notifications
    // ==========================================================
    match /notifications/{notifId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // ==========================================================
    // Accounting & Manual Payments
    // ==========================================================
    match /manual_payments/{paymentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /payment_roles/{roleId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /payment_users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /payment_audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Immutable audit trail
    }

    // ==========================================================
    // Inspection Videos
    // ==========================================================
    match /inspection_videos/{chunkId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // ==========================================================
    // FCM Device Tokens
    // ==========================================================
    match /fcm_tokens/{tokenId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // ==========================================================
    // Vehicle Handover & Repair Tracking System
    // ==========================================================
    match /vehicle_handovers/{handoverId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Immutable Handover Audit Trail (Append-only, strictly no edits or deletes)
    match /handover_audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // ==========================================================
    // Global Default Fallback
    // ==========================================================
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
