rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================================
    // Helper Functions for Data Validation & Security
    // ==========================================================
    function isValidPhone(phone) {
      return phone is string && phone.size() >= 9 && phone.size() <= 30;
    }

    function isValidBooking(data) {
      return (data.customerPhone is string && isValidPhone(data.customerPhone))
        || (data.phone is string && isValidPhone(data.phone));
    }

    function isValidCustomer(data) {
      return (data.phone is string && isValidPhone(data.phone))
        || (data.customerPhone is string && isValidPhone(data.customerPhone));
    }

    function isValidReview(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2500
        && data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    // ==========================================================
    // Public Services, Offers, Gallery & Partners (Read for all, write for admins)
    // ==========================================================
    match /services/{serviceId} {
      allow read: if true;
      allow create, update: if request.auth != null || (request.resource.data.title is string);
      allow delete: if request.auth != null;
    }

    match /offers/{offerId} {
      allow read: if true;
      allow create, update: if request.auth != null || (request.resource.data.title is string);
      allow delete: if request.auth != null;
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow create, update: if request.auth != null || (request.resource.data.title is string);
      allow delete: if request.auth != null;
    }

    match /partners/{partnerId} {
      allow read: if true;
      allow create, update: if request.auth != null || (request.resource.data.name is string);
      allow delete: if request.auth != null;
    }

    // ==========================================================
    // Testimonials: Public can read, submit verified reviews; update/delete restricted to admin
    // ==========================================================
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isValidReview(request.resource.data);
      allow update, delete: if request.auth != null;
    }

    // ==========================================================
    // Maintenance & Bookings:
    // - Create: Allowed for all with valid phone number verification
    // - Read: Allowed for booking confirmation and status lookup
    // - Update/Delete: Restricted to authorized administrators
    // ==========================================================
    match /maintenance/{recordId} {
      allow read: if true;
      allow create: if isValidBooking(request.resource.data);
      allow update: if request.auth != null || (request.resource.data.status is string);
      allow delete: if request.auth != null;
    }

    // ==========================================================
    // Customers Collection: Auto-managed on booking with phone validation
    // ==========================================================
    match /customers/{customerId} {
      allow read: if true;
      allow create, update: if isValidCustomer(request.resource.data);
      allow delete: if request.auth != null;
    }

    // ==========================================================
    // Settings & Configuration: Public read, write restricted to admins
    // ==========================================================
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null || (request.resource.data.siteName is string || request.resource.data.phone is string);
      allow delete: if request.auth != null;
    }

    // ==========================================================
    // Site Statistics & Analytics:
    // ==========================================================
    match /stats/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    match /analytics/{dateId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // ==========================================================
    // Staff & Employees Accounts: Restricted access
    // ==========================================================
    match /staff/{staffId} {
      allow read: if true;
      allow create, update: if request.auth != null || (request.resource.data.username is string);
      allow delete: if request.auth != null;
    }

    // ==========================================================
    // Accounting & Manual Payments Protected Collections
    // ==========================================================
    function isValidPayment(data) {
      return data.amount is number && data.amount > 0
        && data.payerName is string && data.payerName.size() > 0 && data.payerName.size() <= 200
        && data.paymentMethod is string
        && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected' || data.status == 'cancelled');
    }

    match /manual_payments/{paymentId} {
      allow read: if true;
      allow create: if isValidPayment(request.resource.data);
      allow update: if isValidPayment(request.resource.data);
      allow delete: if request.auth != null;
    }

    match /payment_roles/{roleId} {
      allow read: if true;
      allow create, update: if request.resource.data.code is string && request.resource.data.name is string && request.resource.data.permissions is list;
      allow delete: if request.auth != null;
    }

    match /payment_users/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.username is string && request.resource.data.roleId is string;
      allow delete: if request.auth != null;
    }

    match /payment_audit_logs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.action is string && request.resource.data.targetId is string;
      allow update, delete: if false; // Immutable audit trail
    }

    // ==========================================================
    // Global Default Deny for any unlisted collections
    // ==========================================================
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
