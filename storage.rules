rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // =========================================================================
    // Public Media: Gallery, Hero Banners, Customer Car Intake Photos
    // =========================================================================
    match /uploads/public/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 50 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Uploaded via authorized management API
    }

    match /inspection_videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 100 * 1024 * 1024;
    }

    // =========================================================================
    // STRICTLY PROTECTED: Financial Invoices, Vouchers & Accounting Attachments
    // Direct public downloads without server session are completely blocked
    // =========================================================================
    match /accounting/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'accounting-engine@drfix.repair';
    }

    match /accounting_private/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'accounting-engine@drfix.repair';
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
